	"item": [
		{
			"name": "Public Reference Data",
			"item": [
				{
					"name": "1. Get Submitter Options (Public)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var baseUrl = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
									"if (!baseUrl) {",
									"    console.warn(\"[Pre-request] 'base_url' is empty. Defaulting to http://localhost:8000.\");",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Public options returned with submitter types and languages\", function () {",
									"    var jsonData = pm.response.json();",
									"    var envelope = jsonData.message || jsonData;",
									"    var data = envelope.data || envelope;",
									"    pm.expect(data).to.have.property(\"submitter_types\");",
									"    pm.expect(data).to.have.property(\"submission_types\");",
									"    pm.expect(data).to.have.property(\"preferred_languages\");",
									"    pm.expect(data).to.have.property(\"service_categories\");",
									"    pm.expect(data).to.have.property(\"grievance_types\");",
									"    pm.expect(Array.isArray(data.submitter_types)).to.be.true;",
									"    pm.expect(Array.isArray(data.submission_types)).to.be.true;",
									"    pm.expect(Array.isArray(data.service_categories)).to.be.true;",
									"    pm.expect(Array.isArray(data.grievance_types)).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/method/oan_grievance_service.api.v1.submitter.options",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"method",
								"oan_grievance_service.api.v1.submitter.options"
							]
						},
						"description": "Public reference endpoint reachable without authentication. Retrieves dropdown data for submitters, intake forms and public wizards, including active submitter types (Individual Farmer, Development Agent, Cooperative, NGO, etc.), intake channels, supported languages, country phone extensions (ISD codes), service categories, and grievance types."
					},
					"response": []
				},
				{
					"name": "1b. Get Administrative Areas (Public - Cascading/Search)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var baseUrl = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
									"if (!baseUrl) {",
									"    console.warn(\"[Pre-request] 'base_url' is empty. Defaulting to http://localhost:8000.\");",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Administrative areas returned successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    var envelope = jsonData.message || jsonData;",
									"    var data = envelope.data || envelope;",
									"    pm.expect(data).to.have.property(\"areas\");",
									"    pm.expect(Array.isArray(data.areas)).to.be.true;",
									"    pm.expect(data.areas.length).to.be.greaterThan(0);",
									"    pm.expect(data.areas[0]).to.have.property(\"area_id\");",
									"    pm.expect(data.areas[0]).to.have.property(\"area_name\");",
									"    pm.expect(data.areas[0]).to.have.property(\"level_name\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/method/oan_grievance_service.api.v1.administrative_area.get_areas?parent=",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"method",
								"oan_grievance_service.api.v1.administrative_area.get_areas"
							],
							"query": [
								{
									"key": "parent",
									"value": "",
									"description": "Optional parent ID or path_code (e.g. region-ET14 or ET.ET14). If empty, returns top-level regions."
								},
								{
									"key": "level_name",
									"value": "",
									"description": "Optional level filter: Region, Zone, Woreda, Kebele",
									"disabled": true
								},
								{
									"key": "search",
									"value": "",
									"description": "Optional search string matching area name",
									"disabled": true
								},
								{
									"key": "ancestors_of",
									"value": "",
									"description": "Optional area ID to get breadcrumbs hierarchy",
									"disabled": true
								}
							]
						},
						"description": "Public cascading location endpoint. Returns top-level Regions when called without parameters, or child areas (Zones, Woredas, Kebeles) when a 'parent' is provided. Also supports text search and ancestor breadcrumb lookups."
					},
					"response": []
				}
			]
		},
		{
			"name": "Authentication",
			"item": [
				{
					"name": "2a. Register User (Individual Farmer - Fayda / Phone)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var baseUrl = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
									"if (!baseUrl) {",
									"    console.warn(\"[Pre-request] 'base_url' is empty. Defaulting to http://localhost:8000.\");",
									"}",
									"",
									"// Generate fresh unique test credentials to avoid collision on repeated runs",
									"var randSuffix = Date.now().toString().slice(-6) + Math.floor(100 + Math.random() * 900);",
									"var dynamicEmail = \"abebe.farmer.\" + randSuffix + \"@example.com\";",
									"var dynamicMobile = \"+2519\" + randSuffix;",
									"var dynamicFayda = \"ET-FAYDA-\" + randSuffix;",
									"",
									"pm.collectionVariables.set(\"user_email\", dynamicEmail);",
									"pm.collectionVariables.set(\"contact_mobile\", dynamicMobile);",
									"pm.collectionVariables.set(\"fayda_id\", dynamicFayda);",
									"if (pm.environment.name) {",
									"    pm.environment.set(\"user_email\", dynamicEmail);",
									"    pm.environment.set(\"contact_mobile\", dynamicMobile);",
									"    pm.environment.set(\"fayda_id\", dynamicFayda);",
									"}",
									"console.log(\"[Pre-request] Generated fresh test credentials:\", dynamicEmail, dynamicMobile, dynamicFayda);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    var envelope = jsonData.message || jsonData;",
									"    var data = envelope.data || envelope;",
									"    ",
									"    pm.test(\"Response contains tokens\", function () {",
									"        pm.expect(data).to.have.property(\"access_token\");",
									"        pm.expect(data).to.have.property(\"refresh_token\");",
									"    });",
									"",
									"    if (data && data.access_token) {",
									"        pm.collectionVariables.set(\"access_token\", data.access_token);",
									"        if (pm.environment.name) {",
									"            pm.environment.set(\"access_token\", data.access_token);",
									"        }",
									"        console.log(\"[Post-response] Saved access_token:\", data.access_token);",
									"    }",
									"    if (data && data.refresh_token) {",
									"        pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
									"        if (pm.environment.name) {",
									"            pm.environment.set(\"refresh_token\", data.refresh_token);",
									"        }",
									"        console.log(\"[Post-response] Saved refresh_token:\", data.refresh_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"full_name\": \"{{submitter_name}}\",\n    \"email\": \"{{user_email}}\",\n    \"phone_number\": \"{{contact_mobile}}\",\n    \"password\": \"{{user_password}}\",\n    \"role\": \"Grievance Submitter\",\n    \"submitter_type\": \"Individual Farmer\",\n    \"fayda_id\": \"{{fayda_id}}\",\n    \"administrative_area\": \"{{administrative_area}}\",\n    \"administrative_unit\": \"{{administrative_unit}}\",\n    \"preferred_language\": \"{{preferred_language}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/method/oan_auth_service.api.v1.auth.register_user",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"method",
								"oan_auth_service.api.v1.auth.register_user"
							]
						},
						"description": "Registers an Individual Farmer account. Derives canonical dedupe_key as 'fayda:<fayda_id>' or 'phone:<contact_mobile>', initializes the Submitter Profile, and issues access/refresh tokens."
					},
					"response": []
				},
				{
					"name": "2b. Register User (Organization / Cooperative - Reg No & Rep)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var baseUrl = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
									"if (!baseUrl) {",
									"    console.warn(\"[Pre-request] 'base_url' is empty. Defaulting to http://localhost:8000.\");",
									"}",
									"",
									"// Generate fresh unique organization credentials to avoid collision on repeated runs",
									"var randSuffix = Date.now().toString().slice(-6) + Math.floor(100 + Math.random() * 900);",
									"var dynamicOrgEmail = \"coop.oromia.\" + randSuffix + \"@example.com\";",
									"var dynamicOrgMobile = \"+2519\" + randSuffix;",
									"var dynamicRegNo = \"COOP-OROM-\" + randSuffix;",
									"",
									"pm.collectionVariables.set(\"org_email\", dynamicOrgEmail);",
									"pm.collectionVariables.set(\"org_mobile\", dynamicOrgMobile);",
									"pm.collectionVariables.set(\"registration_number\", dynamicRegNo);",
									"if (pm.environment.name) {",
									"    pm.environment.set(\"org_email\", dynamicOrgEmail);",
									"    pm.environment.set(\"org_mobile\", dynamicOrgMobile);",
									"    pm.environment.set(\"registration_number\", dynamicRegNo);",
									"}",
									"console.log(\"[Pre-request] Generated fresh organization test credentials:\", dynamicOrgEmail, dynamicRegNo);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    var envelope = jsonData.message || jsonData;",
									"    var data = envelope.data || envelope;",
									"    ",
									"    pm.test(\"Organization user registered with tokens\", function () {",
									"        pm.expect(data).to.have.property(\"access_token\");",
									"        pm.expect(data).to.have.property(\"refresh_token\");",
									"    });",
									"",
									"    if (data && data.access_token) {",
									"        pm.collectionVariables.set(\"access_token\", data.access_token);",
									"        if (pm.environment.name) {",
									"            pm.environment.set(\"access_token\", data.access_token);",
									"        }",
									"        console.log(\"[Post-response] Saved Organization access_token:\", data.access_token);",
									"    }",
									"    if (data && data.refresh_token) {",
									"        pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
									"        if (pm.environment.name) {",
									"            pm.environment.set(\"refresh_token\", data.refresh_token);",
									"        }",
									"        console.log(\"[Post-response] Saved Organization refresh_token:\", data.refresh_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"full_name\": \"{{authorized_representative}}\",\n    \"email\": \"{{org_email}}\",\n    \"phone_number\": \"{{org_mobile}}\",\n    \"password\": \"{{user_password}}\",\n    \"role\": \"Grievance Submitter\",\n    \"submitter_type\": \"Cooperative\",\n    \"organization_name\": \"{{organization_name}}\",\n    \"registration_number\": \"{{registration_number}}\",\n    \"representative_name\": \"{{authorized_representative}}\",\n    \"administrative_area\": \"{{administrative_area}}\",\n    \"administrative_unit\": \"{{administrative_unit}}\",\n    \"preferred_language\": \"{{preferred_language}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/method/oan_auth_service.api.v1.auth.register_user",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"method",
								"oan_auth_service.api.v1.auth.register_user"
							]
						},
						"description": "Registers an Organization (Cooperative, FPO, NGO, or Local Body). Takes the Organization Name, official Registration Number (which forms dedupe_key as 'org:<registration_number>'), and Authorized Representative contact details."
					},
					"response": []
				},
				{
					"name": "3. Login",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var baseUrl = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
									"var user = pm.environment.get(\"user_email\") || pm.collectionVariables.get(\"user_email\");",
									"var pwd = pm.environment.get(\"user_password\") || pm.collectionVariables.get(\"user_password\");",
									"",
									"if (!baseUrl) {",
									"    console.warn(\"[Pre-request] 'base_url' is empty.\");",
									"}",
									"if (!user || !pwd) {",
									"    console.warn(\"[Pre-request] 'user_email' or 'user_password' is empty. Set credentials before logging in.\");",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    var envelope = jsonData.message || jsonData;",
									"    var data = envelope.data || envelope;",
									"    ",
									"    pm.test(\"Login returned access_token\", function () {",
									"        pm.expect(data).to.have.property(\"access_token\");",
									"        pm.expect(data).to.have.property(\"token_type\");",
									"    });",
									"",
									"    if (data && data.access_token) {",
									"        pm.collectionVariables.set(\"access_token\", data.access_token);",
									"        if (pm.environment.name) {",
									"            pm.environment.set(\"access_token\", data.access_token);",
									"        }",
									"        console.log(\"[Post-response] Saved access_token:\", data.access_token);",
									"    }",
									"    if (data && data.refresh_token) {",
									"        pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
									"        if (pm.environment.name) {",
									"            pm.environment.set(\"refresh_token\", data.refresh_token);",
									"        }",
									"        console.log(\"[Post-response] Saved refresh_token:\", data.refresh_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usr\": \"{{user_email}}\",\n    \"pwd\": \"{{user_password}}\",\n    \"remember_me\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/method/oan_auth_service.api.v1.auth.login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"method",
								"oan_auth_service.api.v1.auth.login"
							]
						},
						"description": "Authenticates user credentials and returns a Bearer access token along with a single-use refresh token. Tokens are automatically saved to Postman variables for subsequent requests."
					},
					"response": []
				},
				{
					"name": "4. Refresh Token",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var refreshToken = pm.environment.get(\"refresh_token\") || pm.collectionVariables.get(\"refresh_token\");",
									"if (!refreshToken) {",
									"    console.warn(\"[Pre-request] 'refresh_token' is empty. Run Login or Register first to obtain one.\");",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    var envelope = jsonData.message || jsonData;",
									"    var data = envelope.data || envelope;",
									"    ",
									"    pm.test(\"Tokens rotated successfully\", function () {",
									"        pm.expect(data).to.have.property(\"access_token\");",
									"        pm.expect(data).to.have.property(\"refresh_token\");",
									"    });",
									"",
									"    if (data && data.access_token) {",
									"        pm.collectionVariables.set(\"access_token\", data.access_token);",
									"        if (pm.environment.name) {",
									"            pm.environment.set(\"access_token\", data.access_token);",
									"        }",
									"        console.log(\"[Post-response] Rotated access_token:\", data.access_token);",
									"    }",
									"    if (data && data.refresh_token) {",
